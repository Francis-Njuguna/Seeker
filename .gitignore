# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets and local config — .env.example is committed, .env is not
.env
.env.*
!.env.example

# Uploaded documents and their blurred derivatives. User ID photos must never
# reach the repo.
uploads/
backend/uploads/

# Video files. A 599 MB mp4 once reached images/ and blocked every push until
# it was rewritten out of history — GitHub hard-rejects blobs over 100 MB, and
# deleting the file in a later commit does not undo that. frontend/.gitignore
# only covered the frontend, so this rule is deliberately repo-wide.
*.mp4
*.mkv
*.avi
*.mov
*.webm

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local DB dumps (dev backups)
backend/backups/
