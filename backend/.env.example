DATABASE_URL=postgresql+asyncpg://seeker:seeker@db:5432/seeker
JWT_SECRET=replace-with-a-long-random-secret
UPLOAD_DIR=/data/uploads
PUBLIC_BASE_URL=http://localhost:8000

# Sandbox OTP returns the code to the UI. Replace with a real SMS adapter before launch.
OTP_PROVIDER=sandbox
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# mock is fully local. Use mpesa with Daraja sandbox credentials for STK Push.
PAYMENT_PROVIDER=mock
PAYMENT_AMOUNT_MINOR=20000
PAYMENT_CURRENCY=KES
PLATFORM_SHARE_RATIO=0.5
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8000/api/payments/webhook

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@example.com

RETENTION_RETURNED_DOCUMENT_DAYS=30
RETENTION_UNCLAIMED_DOCUMENT_DAYS=90
